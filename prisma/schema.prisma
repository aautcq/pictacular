generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  email                  String     @unique
  first_name             String
  last_name              String
  avatar_url             String?
  password               String
  last_sign_in_at        DateTime?
  is_verified            Boolean    @default(false)
  verification_token     String     @unique
  nb_incorrect_passwords Int        @default(0)

  pushSubscription    PushSubscription[]
  resetPasswordToken  ResetPasswordToken[]
  aws_credentials     AwsCredentials?
  sessions            Session[]
  biometrics          Biometrics[]
  albums              Album[] @relation("Albums")
  photos              Photo[] @relation("Photos")
  liked_photos        Photo[] @relation("LikedPhotos")
  admin_albums        Album[] @relation("AdminAlbums")

  @@map("users")
}

model Session {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  active        Boolean @default(true)
  user_agent    String?
  refresh_token String?

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Biometrics {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  credential_id String  @unique
  public_key    String
  counter       Int

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("biometrics")
}

model PushSubscription {
  id         Int        @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  endpoint String
  keys     String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  @@map("push_subsciptions")
}

model ResetPasswordToken {
  id         Int        @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  token     String @unique
  expiresAt DateTime
  expired   Boolean  @default(false)

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  @@map("reset_password_tokens")
}

model AwsCredentials {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  bucket     String
  region     String
  tokens     String

  // Resumable bucket import state (issue #54 follow-up): a "many many
  // photos" import can take well over 30 minutes, which is too long to
  // trust a single HTTP request/connection to survive end-to-end — so
  // POST /api/photos/import processes one S3 ListObjectsV2 page per
  // request instead, persisting just enough state here to pick back up
  // where it left off if a request is interrupted, rather than either
  // restarting the whole bucket walk or losing all progress reporting.
  // `import_cursor` is the S3 ContinuationToken to resume listing from
  // (null before the first page and again once the import completes),
  // `import_imported`/`import_album_ids` are the running counts persisted
  // across those requests to report an accurate final summary.
  import_cursor    String?
  import_total     Int?
  import_imported  Int      @default(0)
  import_album_ids Int[]    @default([])

  user_id Int  @unique
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("aws_credentials")
}

model Photo {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  key           String
  mime_type     String
  size          Int
  last_modified DateTime

  // Issue #162: when the photo was actually taken, derived from the image
  // file's own EXIF metadata (e.g. DateTimeOriginal) at import/upload time
  // — null when no such metadata could be found (unsupported format,
  // missing tag, or a fetch/parse failure), in which case `last_modified`
  // is used instead wherever Photos need a chronological date. Never
  // backfilled for Photos that already existed before this field shipped.
  taken_at DateTime?

  // Issue #145: persisted mirror of the underlying S3 object's current
  // storage class + Restore Request status, refreshed by the
  // `archived-photos:scan` task (and by a User-triggered restore) from
  // `ListObjectsV2`'s free `StorageClass` field / a `HeadObject` restore
  // header — never derived live on a gallery read. `storage_class` is
  // null until the first scan/restore touches this Photo; only `GLACIER`
  // and `DEEP_ARCHIVE` values make it an Archived Photo (see
  // server/utils/archived-photo.ts).
  storage_class      String?
  restore_ongoing    Boolean   @default(false)
  restore_expires_at DateTime?

  user_id Int
  user    User @relation("Photos", fields: [user_id], references: [id], onDelete: Cascade)

  albums   AlbumsOnPhotos[]

  likes    User[] @relation("LikedPhotos")

  @@map("photos")
}

model Album {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  title         String?
  description   String?
  share_token   String?    @unique

  admin_id Int
  admin    User @relation("AdminAlbums", fields: [admin_id], references: [id], onDelete: Cascade)

  photos     AlbumsOnPhotos[]

  users      User[] @relation("Albums")

  invitations Invitation[]

  @@map("albums")
}

model Invitation {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  email String
  token String @unique

  album_id Int
  album    Album @relation(fields: [album_id], references: [id], onDelete: Cascade)

  @@unique([album_id, email])
  @@map("invitations")
}

enum EmailOutboxStatus {
  pending
  sent
  failed
  dead

  @@map("email_outbox_status")
}

model EmailOutbox {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  // Mirrors mailer.ts's EmailType union ('verification' | 'password-reset'
  // | 'invitation') as a plain string rather than a Prisma enum: Prisma
  // enum values must be valid identifiers, and mapping the hyphenated
  // 'password-reset' literal to an underscored enum key would desync the
  // TS-side value from what callers actually pass to sendEmail/this
  // helper.
  type             String
  recipient_email  String
  lang             String
  link             String
  status           EmailOutboxStatus @default(pending)
  attempts         Int               @default(0)
  next_attempt_at  DateTime?
  last_error       String?

  @@map("email_outbox")
}

enum ErrorType {
  DATABASE
  SOCKET
  API
  INTERNAL_SERVER_ERROR

  @@map("error_type")
}

model ApiError {
  id         Int        @id @default(autoincrement())
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  user_id Int?
  user_ip String?

  type    ErrorType
  path    String
  status  Int
  message String
  details String?
  raw     String?

  @@map("api_errors")
}

model AlbumsOnPhotos {
  photo       Photo @relation(fields: [photo_id], references: [id], onDelete: Cascade)
  photo_id    Int

  album       Album @relation(fields: [album_id], references: [id], onDelete: Cascade)
  album_id    Int

  assigned_at DateTime @default(now())

  @@id([photo_id, album_id])
  @@index([photo_id, album_id])
}
