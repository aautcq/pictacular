{
  "name": "@pictacular/api",
  "description": "Pictacular API",
  "author": "Adrien Autricque <adrien.autricque@gmail.com>",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "~18.7.0",
    "npm": "~8.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aautcq/pictacular.git"
  },
  "bugs": {
    "url": "https://github.com/aautcq/pictacular/issues"
  },
  "homepage": "https://github.com/aautcq/pictacular#readme",
  "prettier": "@aautcq/prettier-config",
  "scripts": {
    "afterinstall": "prisma generate && prisma db push",
    "build": "nest build",
    "format": "prettier --write . --ignore-path ../.gitignore",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint -c .eslintrc.js \"{src,apps,libs}/**/*.ts\" --fix --ignore-path ../.gitignore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.461.0",
    "@aws-sdk/s3-request-presigner": "~3.461.0",
    "@nestjs/common": "~10.0.0",
    "@nestjs/config": "~3.1.1",
    "@nestjs/core": "~10.0.0",
    "@nestjs/jwt": "~10.2.0",
    "@nestjs/platform-express": "~10.0.0",
    "@nestjs/platform-socket.io": "~10.2.10",
    "@nestjs/schedule": "~4.0.0",
    "@nestjs/websockets": "~10.2.10",
    "@prisma/client": "~5.6.0",
    "@sendgrid/mail": "~7.7.0",
    "axios": "~1.6.2",
    "bcrypt": "~5.1.1",
    "class-transformer": "~0.5.1",
    "class-validator": "~0.14.0",
    "cookie-parser": "~1.4.6",
    "ejs": "~3.1.9",
    "fido2-lib": "~3.4.3",
    "helmet": "~7.1.0",
    "reflect-metadata": "~0.1.13",
    "rxjs": "~7.8.1",
    "uuid": "~9.0.1",
    "web-push": "~3.6.6"
  },
  "devDependencies": {
    "@aautcq/eslint-config": "~2.1.5",
    "@aautcq/prettier-config": "~2.1.4",
    "@nestjs/cli": "~10.0.0",
    "@nestjs/schematics": "~10.0.0",
    "@types/bcrypt": "~5.0.2",
    "@types/cookie-parser": "~1.4.6",
    "@types/ejs": "~3.1.5",
    "@types/express": "~4.17.17",
    "@types/node": "~20.3.1",
    "@types/uuid": "~9.0.7",
    "@types/web-push": "~3.6.3",
    "nestjs-i18n": "~10.3.7",
    "prisma": "~5.6.0",
    "source-map-support": "~0.5.21",
    "ts-loader": "~9.4.3",
    "ts-node": "~10.9.1",
    "tsconfig-paths": "~4.2.0",
    "typescript": "~5.1.3"
  }
}
