NUXT_DATABASE_URL=
# Tests never touch this database: vitest.config.ts (via
# scripts/test-database-url.mjs) points test runs at a separate
# `<database>_test` database instead, kept schema-in-sync by the `pretest`
# npm script. Tests never call Brevo for real either (see
# server/utils/mailer.ts's isTest guard and vitest.config.ts), but still
# treat this as a secret.
NUXT_BREVO_API_KEY=
NUXT_JWT_PRIVATE_KEY=
NUXT_JWT_PUBLIC_KEY=
NUXT_WEB_PUSH_PUBLIC_KEY=
NUXT_WEB_PUSH_PRIVATE_KEY=
NUXT_COOKIE_DOMAIN=
NUXT_OG_IMAGE_SECRET=
# Pictacular's own AWS account (STS trust anchor for Storage Connection IAM
# Roles — issue #148/ADR-0006, see docs/aws-account-setup.md). Treat the
# access key pair as a secret.
NUXT_AWS_ACCESS_KEY_ID=
NUXT_AWS_SECRET_ACCESS_KEY=
# Public S3 base URL the Storage Connection CloudFormation templates are
# mirrored to (issue #146/#150, see cloudformation/README.md) — not secret.
# e.g. https://pictacular-cfn-templates.s3.eu-west-1.amazonaws.com
NUXT_AWS_CFN_TEMPLATES_BASE_URL=
ENV=
NODE_TLS_REJECT_UNAUTHORIZED=
