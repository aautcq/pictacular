NUXT_DATABASE_URL=
# Tests never call Brevo for real (see server/utils/mailer.ts's isTest
# guard and vitest.config.ts), but still treat this as a secret.
NUXT_BREVO_API_KEY=
NUXT_JWT_PRIVATE_KEY=
NUXT_JWT_PUBLIC_KEY=
NUXT_WEB_PUSH_PUBLIC_KEY=
NUXT_WEB_PUSH_PRIVATE_KEY=
NUXT_AWS_ACCOUNT_ID=
NUXT_AWS_ACCESS_KEY_ID=
NUXT_AWS_SECRET_ACCESS_KEY=
NUXT_COOKIE_DOMAIN=
NUXT_OG_IMAGE_SECRET=
# Pictacular's own AWS account (STS trust anchor for Storage Connection IAM
# Roles — issue #148/ADR-0006, see docs/aws-account-setup.md). Account ID
# isn't secret, but treat the access key pair as one.
NUXT_AWS_ACCOUNT_ID=
NUXT_AWS_ACCESS_KEY_ID=
NUXT_AWS_SECRET_ACCESS_KEY=
ENV=
NODE_TLS_REJECT_UNAUTHORIZED=
